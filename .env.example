# Copy to .env.local for local development (gitignored), and set these in
# Coolify (as runtime environment variables) for production.
# NEVER commit real secrets.

# --- Public site URL (BUILD-TIME: set as a Build Variable in Coolify) ---
NEXT_PUBLIC_SITE_URL=https://www.elevaterecoveryoh.com

# --- SMTP (contact + insurance form delivery) ---
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@example.com
SMTP_PASS=your-smtp-password
# Where form submissions are delivered. Comma-separated for multiple recipients.
# Defaults to mattoakes@healtoledo.com, mikeo@healtoledo.com if unset.
CONTACT_TO_EMAIL=mattoakes@healtoledo.com, mikeo@healtoledo.com
# From address shown on outgoing mail (must be the authenticated mailbox on IONOS)
CONTACT_FROM_EMAIL=your-mailbox@example.com

# --- Anti-abuse ---
# Max form submissions per IP per 24h (default 2)
CONTACT_MAX_PER_DAY=2

# --- Geo restriction (USA only) ---
# true = enforce; false = disable the gate
GEO_RESTRICT_ENABLED=true
# Comma-separated ISO country codes allowed through
GEO_ALLOWED_COUNTRIES=US
